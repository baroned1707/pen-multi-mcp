{
  "name": "pen-multi-mcp",
  "version": "1.3.0",
  "description": "MCP server that drives headless pen.dev CLI sessions: one isolated editor per .pen file, no desktop app required",
  "type": "module",
  "bin": {
    "pen-multi-mcp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test --test-concurrency=1 --test-timeout=300000 test/*.test.js",
    "bench": "node bench/bench.mjs",
    "bench:context": "node bench/context.mjs",
    "eval": "node bench/eval/run.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@pen.dev/cli": "0.3.9",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "zod": "^3.25.0"
  },
  "private": true
}
