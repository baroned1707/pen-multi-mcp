{
  "name": "pen-multi-mcp",
  "version": "0.5.0",
  "description": "MCP server that drives headless pen.dev CLI sessions: one isolated editor per .pen file, no desktop app required",
  "type": "module",
  "bin": {
    "pen-multi-mcp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test --test-concurrency=1 --test-timeout=300000 test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@pen.dev/cli": "0.3.9",
    "zod": "^3.25.0"
  },
  "private": true
}
